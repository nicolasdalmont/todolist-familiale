# Variables d'environnement de la To-Do List Familiale.
#
# En production : définies dans Vercel (Project Settings > Environment
# Variables — voir README.md pour le détail de chacune).
# En local : copier ce fichier en .env.local et renseigner les valeurs.
#   cp .env.example .env.local
# .env.local est ignoré par git (voir .gitignore) — ne jamais le committer.

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=

# Supabase > Project Settings > API > Project API keys > service_role
# (PAS la clé "anon"). Contourne Row Level Security : strictement secrète,
# jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Chaîne aléatoire longue qui signe les cookies de session (JWT).
# En local, reprendre EXACTEMENT la valeur de Vercel : la changer
# invalide toutes les sessions existantes. Pour un tout nouvel
# environnement uniquement : openssl rand -base64 48
SESSION_SECRET=

# Notifications push web (voir doc technique §6.15) — paire de clés VAPID,
# à générer UNE FOIS avec `npx web-push generate-vapid-keys` et à garder
# ensuite (la régénérer invaliderait tous les abonnements déjà enregistrés).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY reste en clair (le préfixe NEXT_PUBLIC_
# l'expose intentionnellement au navigateur) ; VAPID_PRIVATE_KEY est
# strictement secrète.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact "mailto:..." transmis au service push en cas de souci de
# délivrabilité — jamais affiché aux utilisateurs.
VAPID_SUBJECT=

# Secret partagé qui protège /api/cron/reminders (rappel quotidien
# d'échéance, voir vercel.json). Vercel Cron ajoute automatiquement
# l'en-tête "Authorization: Bearer <CRON_SECRET>" à ses appels quand cette
# variable est définie sur le projet — à générer une fois
# (ex. openssl rand -base64 32).
CRON_SECRET=

